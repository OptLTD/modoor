{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "vue": ["./node_modules/vue"],
      "vue-router": ["./node_modules/vue-router"],
      "jspreadsheet-ce": ["./node_modules/jspreadsheet-ce"],
      "jsuites": ["./node_modules/jsuites"],
      "@modoor/hooks": ["../../../packages/hooks/src"],
      "@modoor/widget": ["../../../packages/widget/src"],
      "@modoor/widget/*": ["../../../packages/widget/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../../../packages/hooks/src/**/*.ts",
    "../../../packages/widget/src/**/*.ts",
    "../../../packages/widget/src/**/*.vue"
  ]
}
