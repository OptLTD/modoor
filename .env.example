# Modoor env — copy to .env for local use
MODOOR_API_KEY=dev-key-change-me
MODOOR_TENANT=demo
# Optional int overrides after bootstrap (defaults: admin user / root team)
# MODOOR_USER_ID=1
# MODOOR_TEAM_ID=1
MODOOR_CONFIRM_SECRET=dev-confirm-secret-change-me
MODOOR_CONFIRM_TTL_SECONDS=600

DATABASE_URL=sqlite:///./modoor.db

# Repo root for modules/ (optional; auto-detected from package)
# MODOOR_MODULES_ROOT=
MODOOR_WEB_HOST=127.0.0.1
MODOOR_WEB_PORT=8765
# Console / login host (template on API). Module SPAs listed separately.
MODOOR_WEBUI_URL=http://127.0.0.1:8765
MODOOR_WEBUI_MODULE_URLS=base=http://127.0.0.1:5175,wiki=http://127.0.0.1:5176,sale=http://127.0.0.1:5177,skill=http://127.0.0.1:5178,doc=http://127.0.0.1:5179
# Preview: comma module ids to mount dist (empty = all with dist). Dev uses MODOOR_WEBUI_PROXIES instead.
# MODOOR_WEBUI_STATIC_MODULES=base,wiki,sale,skill,doc
# MODOOR_WEBUI_PROXIES=

# doc module blob storage (v1: local only; s3/minio reserved)
MODOOR_DOC_STORAGE=local
MODOOR_DOC_LOCAL_ROOT=./data/doc
# MODOOR_DOC_S3_ENDPOINT=
# MODOOR_DOC_S3_BUCKET=
# MODOOR_DOC_S3_ACCESS_KEY=
# MODOOR_DOC_S3_SECRET_KEY=
# MODOOR_DOC_S3_REGION=
# MODOOR_DOC_S3_PREFIX=doc/

MODOOR_SESSION_SECRET=dev-session-secret-change-me
MODOOR_ADMIN_USERNAME=admin
MODOOR_ADMIN_PASSWORD=admin123

# External apps → Modoor registry
# MODOOR_URL=http://127.0.0.1:8765
# EXTERNAL_BOARD_PORT=8771
# EXTERNAL_PULSE_PORT=8772
